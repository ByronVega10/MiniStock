{
  "name": "ministock-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend inicial de MiniStock",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "prisma generate --config prisma.config.ts && nest build",
    "prestart": "prisma generate --config prisma.config.ts",
    "start": "nest start",
    "prestart:dev": "prisma generate --config prisma.config.ts",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate deploy --config prisma.config.ts",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:integration": "npm run build && node --test test/integration/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "11.2.7",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prisma": "7.10.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
